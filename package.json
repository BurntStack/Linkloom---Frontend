{
  "name": "linkloom-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.mjs\"",
    "parity": "node tests/parity/run.mjs",
    "test:journey": "node tests/e2e/journey.mjs",
    "test:onboarding-api": "node tests/e2e/onboarding-api.mjs",
    "test:live": "node tests/e2e/live-smoke.mjs",
    "test:mocked": "node tests/e2e/live-mocked.mjs && node tests/e2e/live-actions.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "gsap": "3.12.5",
    "lenis": "1.1.13"
  },
  "devDependencies": {
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
